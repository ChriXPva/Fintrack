<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.RelatorioController" stylesheets="@../styles/style.css"
      spacing="15" alignment="CENTER" prefWidth="350" prefHeight="250">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Resumo Financeiro" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label fx:id="lblSaldo" text="Saldo Total: R$ 0,00" style="-fx-font-size: 16px;"/>

    <Button text="Fechar" styleClass="button-secondary" onAction="#fecharJanela"/>
</VBox>